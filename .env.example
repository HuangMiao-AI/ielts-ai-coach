# Local development settings. Never put real secrets in this file.
DATABASE_URL=sqlite:///data/ielts_ai_coach.db
BACKUP_DIR=data/backups

# Optional Alibaba Cloud Model Studio configuration.
# Leave QWEN_API_KEY empty to use the local Mock AI provider.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
